# callmem default configuration
# Copy this to .callmem/config.toml in your project root and edit as needed.
# All settings have sensible defaults — you only need to override what you
# want to change.

# ── LLM backend ──────────────────────────────────────────
[llm]
# Which model to use for memory maintenance (extraction, summarization, etc.)
# Options: "ollama", "openai_compat", "none"
#   "ollama"        — local Ollama instance (recommended)
#   "openai_compat" — any OpenAI-compatible API (LM Studio, vLLM, GLM, etc.)
#   "none"          — pattern matching only, no LLM features
backend = "ollama"

# ── Ollama backend ───────────────────────────────────────
[ollama]
# Ollama API endpoint
endpoint = "http://localhost:11434"
# Model to use for extraction and summarization
# Recommended: qwen3:8b (4GB VRAM) or qwen3:30b (16GB VRAM)
model = "qwen3:8b"
# Request timeout in seconds
timeout = 120
# Context window size (null = model default)
num_ctx = null

# ── OpenAI-compatible backend ────────────────────────────
# Only used when [llm].backend = "openai_compat"
[openai_compat]
endpoint = "https://open.bigmodel.cn/api/paas/v4"
model = "glm-4-flash"
# Environment variable containing the API key
api_key_env = "CALLMEM_API_KEY"
timeout = 120

# ── Embeddings (hybrid search) ───────────────────────────
# When a backend is reachable, entity search fuses full-text (bm25) and
# semantic (cosine) rankings. With no backend or no stored vectors,
# search silently falls back to full-text only — nothing breaks.
[embeddings]
enabled = true
# "ollama" (local, free, private), "openai_compat", or "none"
backend = "ollama"
# Ollama: `ollama pull nomic-embed-text` (768 dims, ~270MB)
model = "nomic-embed-text"
# Overrides the backend's own endpoint when set; null uses
# [ollama].endpoint / [openai_compat].endpoint
endpoint = null
# Ingest/backfill budget in seconds
timeout = 60
# Interactive search budget in seconds. A hung backend costs a search this
# long, then the query is served from full-text search alone.
query_timeout = 3.0
# Entities per embedding request
batch_size = 32
# How many stored vectors one query scores, most-recently-updated first.
# Higher = better recall over old entities, slower search. At 768 dims:
# 500 ≈ 40ms, 2000 ≈ 93ms, 10000 ≈ 374ms.
candidate_limit = 500
# Cosine floor for a vector hit to enter the fused ranking. Calibrated
# for nomic-embed-text (related pairs 0.49-0.57, unrelated below 0.43).
min_similarity = 0.45
# Asymmetric task prefixes nomic-embed-text is trained on. Set both to ""
# for models that don't use them. Changing these after embedding requires
# a re-embed (stored vectors would no longer match query vectors).
query_prefix = "search_query: "
document_prefix = "search_document: "

# ── Consolidation ─────────────────────────────────────────
# At extraction-batch completion, each newly-extracted entity is checked
# against its most similar existing entities (vector search when embeddings
# are available, full-text otherwise). If the best match clears `threshold`,
# one batched LLM call judges ADD (distinct, keep both) / UPDATE (new entity
# refines an old one — old marked stale+superseded) / NOOP (duplicate — new
# entity archived). Fail-open: a malformed, absent, or even partially-answered
# judge response keeps everything as ADD. Nothing is ever deleted — verdicts
# only ever mark an entity stale or archived, both reversible states.
#
# Off by default: this feature marks stale / archives entities that already
# exist in your project's memory, and `threshold` is only calibrated against
# a small probe corpus, not your data. Turn it on once you've watched it run
# (consolidation_log records added/updated/noop/judge_failed per run) and are
# comfortable with the threshold.
[consolidation]
enabled = false
# Same 0..1 similarity scale as [embeddings].min_similarity
threshold = 0.55
# Top-K similar existing entities considered per new entity
top_k = 5

# ── Web UI ───────────────────────────────────────────────
[ui]
# Port to serve the web interface on
port = 9090
# Bind address. 0.0.0.0 enables access from other machines on your network
# (e.g., via Tailscale). Use 127.0.0.1 for local-only access.
host = "0.0.0.0"

# ── Briefing ─────────────────────────────────────────────
[briefing]
# Maximum token budget for the startup briefing
max_tokens = 2000
# Deprecated: the flat-file snapshot of the briefing.
# Leave false — agents should call `callmem briefing` (CLI) or `mem_get_briefing` (MCP)
# for a live briefing. Setting this to true rewrites a stale snapshot on each
# extraction pass, which agents may then read and present as current.
auto_write_session_summary = false
session_summary_filename = "SESSION_SUMMARY.md"
# Max entities per type in the briefing
max_per_type = 20
# Include the most recent session in the briefing
include_last_session = true
# Default content view: "key_points" or "synopsis"
default_view = "key_points"
# Optional focus filter (null = show everything)
focus = null
# Only include specific entity types (empty list = all types). Example:
# entity_types = ["decision", "fact", "todo"]

# ── Extraction ───────────────────────────────────────────
[extraction]
# Number of events to send to the LLM in each extraction batch
batch_size = 10

# ── Ingestion filters ────────────────────────────────────
[ingestion]
# Tool names to skip recording (e.g., tool names to filter out).
# Each entry is matched against the part before the first "(" in tool_call content.
# skip_tools = ["Read", "Write", "Edit"]
skip_tools = []
# Glob patterns to skip entire events by content
# skip_patterns = ["Read(*node_modules*)"]
skip_patterns = []

# ── Summarization ────────────────────────────────────────
[summarization]
# Number of events before a chunk summary is generated
chunk_size = 20
# Number of sessions before a cross-session summary is generated
cross_session_interval = 5

# ── Compaction ───────────────────────────────────────────
[compaction]
# Enable automatic archival of old events
enabled = true
# When to compact: "on_session_end" or "interval"
schedule = "on_session_end"
# Max events before triggering compaction
max_events = 500

# ── Sensitive data handling ──────────────────────────────
[sensitive_data]
# Enable sensitive data detection (pattern matching + optional LLM scan)
enabled = true
# Vault key management mode: "auto" (random key), "passphrase" (from env var),
# or "disabled" (no encryption — not recommended)
vault_mode = "auto"
# Pattern-based scan for credentials, API keys, tokens, etc.
pattern_scan = true
# LLM-based contextual scan (requires a working LLM backend)
llm_scan = true
# Minimum confidence threshold for LLM scan results (0.0 - 1.0)
llm_scan_confidence = 0.7

# ── Adapters ─────────────────────────────────────────────
[adapters]
# Enable the OpenCode SSE adapter for real-time event capture
opencode = true
# Enable the Claude Code JSONL tailer
claude_code = true
# Seconds before an idle Claude Code session is automatically ended
claude_code_idle_timeout = 300.0
# Seconds between polling for new JSONL files
claude_code_poll_interval = 2.0

# ── Endless mode (context compression) ───────────────────
[endless_mode]
# Enable advisory context compression tools
enabled = true
# Model context window in tokens (null = derive from ollama.num_ctx)
context_limit = null
# Context usage ratio that triggers a compression recommendation
compress_threshold = 0.8
# Number of oldest messages to compress each time
chunk_size = 30

# ── Environment variable overrides ───────────────────────
# Any config value can be overridden at runtime via environment variables
# using the format: CALLMEM_<SECTION>__<KEY>
#
# Examples:
#   CALLMEM_OLLAMA__MODEL=qwen3:30b
#   CALLMEM_UI__PORT=9091
#   CALLMEM_SENSITIVE_DATA__LLM_SCAN=false
#   CALLMEM_ADAPTERS__OPENCODE=false
#
# Nested keys use double underscores. The env var always wins over TOML values.
